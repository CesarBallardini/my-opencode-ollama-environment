@echo off
rem Claude Code wrapper: the local (air-gapped) profile inside a confidential directory, the cloud
rem profile elsewhere. Confidential roots: %USERPROFILE%\local-llm\confidential-roots.txt, one
rem directory per line, # comments allowed, %VAR% references expanded. The cloud binary path
rem comes from %USERPROFILE%\local-llm\cloud-binaries.cmd, generated by install.py.
setlocal EnableDelayedExpansion
set "LLM=%USERPROFILE%\local-llm"
set "CWD=%CD%\"
if exist "%LLM%\confidential-roots.txt" for /f "usebackq eol=# delims=" %%r in ("%LLM%\confidential-roots.txt") do (
  set "ROOT=%%r"
  call set "ROOT=!ROOT!"
  set "ROOT=!ROOT:/=\!"
  if "!ROOT:~-1!"=="\" set "ROOT=!ROOT:~0,-1!"
  if not "!ROOT!"=="" (
    echo !CWD!|findstr /I /B /L /C:"!ROOT!\" >nul && (
      endlocal & call "%USERPROFILE%\local-llm\claude-local.cmd" %* & exit /b
    )
  )
)
set "CLAUDE_CLOUD_EXE="
if exist "%LLM%\cloud-binaries.cmd" call "%LLM%\cloud-binaries.cmd"
if "%CLAUDE_CLOUD_EXE%"=="" (
  echo cloud profile not installed; use claude-local 1>&2
  exit /b 1
)
endlocal & "%CLAUDE_CLOUD_EXE%" %*
